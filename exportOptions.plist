<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- 
        method может быть одним из:
        - development: для разработки и тестирования
        - ad-hoc: для установки на конкретные устройства (до 100)
        - app-store: для публикации в App Store
        - enterprise: для корпоративного распространения
    -->
    <key>method</key>
    <string>development</string>
    
    <!-- 
        signingStyle может быть:
        - automatic: автоматическое управление подписями
        - manual: ручное управление (требует teamID и provisioningProfiles)
    -->
    <key>signingStyle</key>
    <string>automatic</string>
    
    <!-- 
        Раскомментируйте и укажите ваш Team ID, если используете manual signing:
        <key>teamID</key>
        <string>YOUR_TEAM_ID</string>
    -->
    
    <!-- 
        Для manual signing укажите provisioning profiles:
        <key>provisioningProfiles</key>
        <dict>
            <key>com.player.app</key>
            <string>PROVISIONING_PROFILE_NAME</string>
        </dict>
    -->
</dict>
</plist>
